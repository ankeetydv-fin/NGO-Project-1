# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-05-24"

# Sanity API Token for form submissions (contact, volunteer, newsletter)
# IMPORTANT: Must be an "Editor" token (not "Viewer") to allow document creation.
# Generate at: https://www.sanity.io/manage → Your Project → API → Tokens → Add API token
# Select role: "Editor" (or "Deploy Studio" for full access)
SANITY_API_TOKEN="your-editor-api-token"
